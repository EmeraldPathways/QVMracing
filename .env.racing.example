QVM_RACING_DATABASE_URL=sqlite:///./qvm_racing.sqlite3
QVM_RACING_SITE_URL=
QVM_RACING_WORKER_SHARED_SECRET=
QVM_RACING_PROVIDER=demo
QVM_RACING_PROVIDER_TIMEOUT_SECONDS=30
RACING_API_BASE_URL=https://api.theracingapi.com
RACING_API_USERNAME=
RACING_API_PASSWORD=
# Open-Meteo is used for forecast and historical weather; no API key is required.
OPEN_METEO_ATTRIBUTION=Open-Meteo (CC BY 4.0)
QVM_RACING_SITE_SYNC_TIMEOUT_SECONDS=300
QVM_RACING_WORKER_INTERVAL_SECONDS=300
QVM_RACING_NEAR_OFF_INTERVAL_SECONDS=15
RACING_EDGE_THRESHOLD=0.03
RACING_MAX_STAKE_PCT=0.02
RACING_MAX_RACE_EXPOSURE_PCT=0.05
RACING_MAX_MEETING_EXPOSURE_PCT=0.10
RACING_MAX_OPEN_EXPOSURE_PCT=0.25
RACING_MAX_DAILY_LOSS_PCT=0.03
AUTO_PAPER_TRADES=false
QVM_RACING_KILL_SWITCH=false
